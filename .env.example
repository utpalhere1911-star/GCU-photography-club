# ShutterScape - University Photography Club Environment Configuration
# Girijananda Chowdhury University (GCU), Guwahati

# ====================================================================
# Supabase Authentication & Database Configuration
# Obtain from: Supabase Project Dashboard -> Project Settings -> API
# ====================================================================
# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public / Anon API Key (safe for browser client requests)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (STRICTLY SERVER-SIDE - NEVER EXPOSE TO CLIENT)
# Required for server-side role lookups and administrative access
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ====================================================================
# Session & Cryptographic Security
# ====================================================================
# Secret key used for HMAC-SHA256 signing of session cookies (minimum 32 characters)
SHUTTERSCAPE_AUTH_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

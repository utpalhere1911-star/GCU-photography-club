# ====================================================================
# ShutterScape — Disposable Test Environment Template
# Girijananda Chowdhury University (GCU), Guwahati, Assam
# File: .env.test.example
# ====================================================================
# INSTRUCTIONS:
# 1. Create a free, temporary disposable project at https://supabase.com/dashboard/new.
# 2. Copy this template to .env.test.local:
#      copy .env.test.example .env.test.local
# 3. Replace the placeholder values below with your disposable test project keys.
# 4. NEVER PUT PRODUCTION CREDENTIALS OR SERVICE KEYS IN THIS FILE.
# ====================================================================

# Disposable Test Project URL (PLACEHOLDER)
DISPOSABLE_SUPABASE_URL=https://your-disposable-project-id.supabase.co

# Disposable Test Anon Key (PLACEHOLDER - safe for browser/public requests in test project)
DISPOSABLE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_disposable_anon_key_placeholder

# Disposable Test Service Role Key (PLACEHOLDER - test environment only, never production)
DISPOSABLE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_disposable_service_role_key_placeholder

# Secret key for test session token signing (minimum 32 characters)
DISPOSABLE_AUTH_SECRET=disposable_test_secret_key_minimum_32_characters_long!
